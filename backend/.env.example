# Copy to backend/.env for local runs; on Cloud Run set these once with
# `gcloud run services update ... --update-env-vars` (values survive redeploys).
# Values here are placeholders — never commit real keys or phone numbers.

# ── Core (already set on Cloud Run) ────────────────────────────────────
OPENAI_API_KEY=sk-your-key
VOCAL_BRIDGE_API_KEY=vb-your-key
# Agent used by the Phase 4 smoke-test page (/v1/vb_test/).
VOCAL_BRIDGE_AGENT_ID=agent-id

# ── Phase 7: L4 outbound-call tool (/v1/outbound_call) ─────────────────
# The provisioned lesson-4 caller agent (created once via `vb agent create`,
# outbound enabled — see jupyter_notebook/training_course/L4/L4.ipynb).
VOCAL_BRIDGE_CALLER_AGENT_ID=agent-id
# The verified demo cell phone the caller agent dials. Kept out of source.
VOCAL_BRIDGE_CALLEE_PHONE=+15555550100
# Optional: overrides the caller agent's provisioned outbound greeting.
# VOCAL_BRIDGE_OUTBOUND_GREETING=Hi! This is the Vocal Bridge demo agent.

# ── Phase 7: cascaded pipeline models (/v1/cascade_demo) — optional ────
# Defaults live in api/cascade_core.py; override only to experiment.
# CASCADE_STT_MODEL=gpt-4o-mini-transcribe
# CASCADE_LLM_MODEL=gpt-5.4-mini
# CASCADE_TTS_MODEL=gpt-4o-mini-tts
# CASCADE_TTS_VOICE=alloy
