# Copy to backend/.env for local runs; on Cloud Run set these once with
# `gcloud run services update ... --update-env-vars` (values survive redeploys).
# Values here are placeholders — never commit real keys or phone numbers.

# ── Core (already set on Cloud Run) ────────────────────────────────────
OPENAI_API_KEY=sk-your-key
VOCAL_BRIDGE_API_KEY=vb-your-key
# Agent used by the Phase 4 smoke-test page (/v1/vb_test/).
VOCAL_BRIDGE_AGENT_ID=agent-id

# ── Phase 7: L4 outbound-call tool (/v1/outbound_call) ─────────────────
# The provisioned lesson-4 caller agent (created once via `vb agent create`,
# outbound enabled — see jupyter_notebook/training_course/L4/L4.ipynb).
VOCAL_BRIDGE_CALLER_AGENT_ID=agent-id
# The verified demo cell phone the caller agent dials. Kept out of source.
VOCAL_BRIDGE_CALLEE_PHONE=+15555550100
# Optional: overrides the caller agent's provisioned outbound greeting.
# VOCAL_BRIDGE_OUTBOUND_GREETING=Hi! This is the Vocal Bridge demo agent.

# ── Text LLM: Featherless (OpenAI-compatible chat) when set ───────────
# Concierge, Cascade agent_reply, consent classifier, itinerary parse.
# STT/TTS stay on OpenAI. Unset → gpt-5.4-mini via OPENAI_API_KEY.
# FEATHERLESS_API_KEY=
# FEATHERLESS_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct
# CONCIERGE_LLM_MODEL=gpt-5.4-mini

# ── Phase 7: cascaded pipeline models (/v1/cascade_demo) — optional ────
# Defaults live in api/cascade_core.py; override only to experiment.
# STT/TTS stay on OpenAI even when Featherless is the text LLM.
# CASCADE_STT_MODEL=gpt-4o-mini-transcribe
# CASCADE_LLM_MODEL=gpt-5.4-mini
# CASCADE_TTS_MODEL=gpt-4o-mini-tts
# CASCADE_TTS_VOICE=alloy

# Optional: Google Maps Directions/Geocoding for Optimize My Trip.
# Unset → honest demo geometry (never labeled as Google).
# GOOGLE_MAPS_API_KEY=

# Optimize My Trip voice orb (separate from Cascade / web_call).
# BUILD_AGENT_ID must be a Vocal Bridge agent UUID (xxxxxxxx-xxxx-…),
# NOT an API key (vb_…). A vb_ value makes the orb skip backend
# delegation and invent “need more info” answers.
# VOCAL_BRIDGE_BUILD_API_KEY=vb-your-build-key
# VOCAL_BRIDGE_BUILD_AGENT_ID=00000000-0000-0000-0000-000000000000

# Optional: live Uber price/time estimates for the first stop
# (as if the traveler is standing at stop 1). Unset → no Uber fares;
# the deep link still opens Uber looking with those coordinates.
# UBER_SERVER_TOKEN=
# UBER_ACCESS_TOKEN=
# UBER_CLIENT_ID=

# WhatsApp ingest for Cascade Repairer (webhook not wired until phone id is set).
# WHATSAPP_API_KEY=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_VERIFY_TOKEN=

# Outbound itinerary email (Resend). Missing key → agent says send failed.
# Domain talktomytrip.com must be Verified on the same Resend account as this key.
# RESEND_API_KEY=re_your_key
# Optional override if the default domain is unverified on this key:
# RESEND_FROM=Cascade <onboarding@resend.dev>
